# ─── Google Sheets Integration ────────────────────────────────────────────────
# ID de tu Google Spreadsheet (lo encontrás en la URL: /spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Credenciales de la Service Account de Google Cloud
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\ntu_clave_privada_aqui\n-----END RSA PRIVATE KEY-----"

# Nombre de la pestaña/hoja en el Spreadsheet (default: "Stock")
GOOGLE_SHEETS_TAB=Stock

# ─── WhatsApp ──────────────────────────────────────────────────────────────────
# Número de WhatsApp sin +, sin espacios (ej: 5491112345678 para Argentina)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491112345678

# ─── Configuración General ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=CarShip
NEXT_PUBLIC_SITE_URL=https://carship.ar
